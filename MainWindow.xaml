<Window x:Class="CoreSentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreSentinel" 
        Icon="app.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Height="720" Width="1080"
        MinWidth="920" MinHeight="600"
        Background="{DynamicResource BrushBgBase}"
        FontFamily="{DynamicResource FontMain}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="48"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 1. HEADER / TITLEBAR                                         -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <!-- Brand -->
                    <ColumnDefinition Width="220"/>
                    <!-- Unified Status Chip Bar (Draggable) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Actions & Window Caption Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo (Clean, no PRO badge!) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandLogoImage" Source="logo.png" Width="18" Height="18" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="CoreSentinel" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Live System Telemetry (Clickable CPU & RAM -> Process Inspector) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- CPU -->
                    <StackPanel x:Name="QuickCpuMetric" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="CpuMetric_Click" ToolTip="Open Windows Task Manager">
                        <Path Data="{StaticResource IconCpu}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU " FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickCpuText" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separator Dot -->
                    <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource BrushBorderHover}" Margin="10,0" VerticalAlignment="Center"/>

                    <!-- RAM -->
                    <StackPanel x:Name="QuickRamMetric" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="RamMetric_Click" ToolTip="Open Process Inspector (RAM)">
                        <Path Data="{StaticResource IconRam}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RAM " FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickRamText" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separator Dot -->
                    <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource BrushBorderHover}" Margin="10,0" VerticalAlignment="Center"/>

                    <!-- System Storage (Clickable -> Opens Explorer in System Drive) -->
                    <StackPanel x:Name="QuickDiskMetric" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="DiskCMetric_Click" ToolTip="Open Drive in Windows Explorer">
                        <Path Data="{StaticResource IconHardDrive}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickDiskCLabel" Text="Drive: " FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickDiskCText" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separator Dot -->
                    <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource BrushBorderHover}" Margin="10,0" VerticalAlignment="Center"/>

                    <!-- Game Mode -->
                    <Path Data="{StaticResource IconGamepad}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Ellipse x:Name="GameModeDot" Width="5" Height="5" Fill="{DynamicResource BrushTextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GameModeText" Text="Waiting for games" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Actions + Caption Buttons (Clean ghost button for HUD, no bulky pill buttons!) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleHud" Style="{StaticResource BtnGhostTitlebar}" Click="BtnToggleHud_Click" Margin="0,0,10,0" ToolTip="Toggle compact floating HUD overlay">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPictureInPicture}" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="HUD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="16" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                    <!-- Window Caption Buttons -->
                    <Button Click="BtnMinimize_Click" Style="{StaticResource WinCaptionButton}">
                        <Path Data="M 0,5 H 10 V 6 H 0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnMaximize_Click" Style="{StaticResource WinCaptionButton}">
                        <Path Data="M 0,0 H 9 V 9 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Fill="Transparent" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnClose_Click" Style="{StaticResource WinCloseButton}">
                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 2. MAIN WORKSPACE (SIDEBAR + CONTENT)                        -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Nav Sidebar -->
                <ColumnDefinition Width="220"/>
                <!-- Main Content Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR (Claude-style calm list) -->
            <Border Grid.Column="0" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Nav Pills List -->
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="NavHeaderTitle" Text="NAVIGATION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="12,0,0,12"/>
                        <StackPanel x:Name="NavPillsContainer"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT WORKSPACE -->
            <Grid Grid.Column="1" Margin="28,22">

                <!-- ========================================== -->
                <!-- TAB 0: DASHBOARD                           -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentDashboard" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 3 Stat Cards Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Lower Detail Cards Row -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="DashHeadingTitle" Text="System Overview" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock x:Name="DashHeadingSub" Text="Real-time hardware telemetry and background process monitoring" FontSize="13.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                        
                    </StackPanel>

                    <!-- 3 Core Metric Cards (.card style, airy, clean) -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: CPU (Clickable -> Opens Task Manager) -->
                        <Border x:Name="DashCpuCard" Grid.Column="0" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,10,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="DashCardCpuTitle" Text="PROCESSOR (CPU)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                    <Border x:Name="BtnCpuAction" Cursor="Hand" MouseLeftButtonDown="CpuMetric_Click" ToolTip="Open Windows Task Manager" HorizontalAlignment="Right" Background="Transparent" Padding="4,2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCpu}" Width="13" Height="13" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource IconArrowUpRight}" Width="10" Height="10" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Clickable Metric Zone -->
                                <StackPanel x:Name="MetricCpuAction" Cursor="Hand" MouseLeftButtonDown="CpuMetric_Click" ToolTip="Open Windows Task Manager" Background="Transparent">
                                    <TextBlock x:Name="DashCpuVal" Text="0%" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,10,0,6"/>
                                    <ProgressBar x:Name="DashCpuProgress" Style="{StaticResource ProgressBarMonochrome}" Value="0" Maximum="100" Margin="0,4,0,10"/>
                                </StackPanel>

                                <TextBlock x:Name="DashCpuSub" Text="Detecting processor..." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: RAM (Clickable -> Opens Process Manager sorted by RAM) -->
                        <Border x:Name="DashRamCard" Grid.Column="1" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="5,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="DashCardRamTitle" Text="PHYSICAL MEMORY" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                    <Border x:Name="BtnRamAction" Cursor="Hand" MouseLeftButtonDown="RamMetric_Click" ToolTip="Open Process Manager (sorted by RAM)" HorizontalAlignment="Right" Background="Transparent" Padding="4,2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconRam}" Width="13" Height="13" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource IconArrowUpRight}" Width="10" Height="10" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Clickable Metric Zone -->
                                <StackPanel x:Name="MetricRamAction" Cursor="Hand" MouseLeftButtonDown="RamMetric_Click" ToolTip="Open Process Manager (sorted by RAM)" Background="Transparent">
                                    <TextBlock x:Name="DashRamVal" Text="0%" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,10,0,6"/>
                                    <ProgressBar x:Name="DashRamProgress" Style="{StaticResource ProgressBarMonochrome}" Value="0" Maximum="100" Margin="0,4,0,10"/>
                                </StackPanel>

                                <TextBlock x:Name="DashRamSub" Text="Used: 0 / 8.0 GB" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Storage (Clickable -> Opens Explorer in System Drive) -->
                        <Border x:Name="DashDiskCCard" Grid.Column="2" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="10,0,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="DashDiskCTitle" Text="STORAGE (C:)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnDashDiskDropdown" Style="{StaticResource BtnIconCircle}" Click="BtnDiskDropdown_Click" Margin="4,0,0,0" ToolTip="Select Drive">
                                            <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                    <Border x:Name="BtnDiskAction" Cursor="Hand" MouseLeftButtonDown="DiskCMetric_Click" ToolTip="Open drive in Windows Explorer" HorizontalAlignment="Right" Background="Transparent" Padding="4,2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconHardDrive}" Width="13" Height="13" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource IconArrowUpRight}" Width="10" Height="10" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Clickable Metric Zone (as per область.png) -->
                                <StackPanel x:Name="MetricDiskAction" Cursor="Hand" MouseLeftButtonDown="DiskCMetric_Click" ToolTip="Open drive in Windows Explorer" Background="Transparent">
                                    <TextBlock x:Name="DashDiskCVal" Text="0.0 GB" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,10,0,6"/>
                                    <ProgressBar x:Name="DashDiskCProgress" Style="{StaticResource ProgressBarMonochrome}" Value="0" Maximum="100" Margin="0,4,0,10"/>
                                </StackPanel>

                                <TextBlock x:Name="DashDiskCSub" Text="Free 0.0 of 0.0 GB" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Lower Split Cards (NO nested boxes! Clean typographic rows) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Status & Environment (Clean rows with dividers) -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="DashEnvCardTitle" Grid.Row="0" Text="Gaming environment and storage status" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,16"/>

                                <StackPanel Grid.Row="1">
                                    <!-- Row 1: Game Mode (Structured columns, never overlaps in compact window mode!) -->
                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Path Data="{StaticResource IconGamepad}" Width="13" Height="13" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashGameStatusTitle" Text="Game Process Priority" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DashGameStatusDetail" Text="No games detected · Background monitoring active" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="21,0,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource BrushBgInner}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="DashGameBadge" Text="Waiting" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </Border>
                                    </Grid>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,10"/>

                                    <!-- Row 2: Secondary Data Disk (Clickable -> Opens Explorer) -->
                                    <Grid x:Name="DashDiskDRow" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="DiskDMetric_Click" ToolTip="Click to open data drive in Windows Explorer">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Path Data="{StaticResource IconHardDrive}" Width="13" Height="13" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashDiskDTitle" Text="Data Drive" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DashDiskDText" Text="Free: 0.0 GB" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="21,0,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource BrushBgInner}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="DashDiskDBadge" Text="Data Drive" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </Border>
                                    </Grid>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,10"/>

                                    <!-- Row 3: Health Recommendation -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Path Data="{StaticResource IconCheckCircle}" Width="13" Height="13" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashHealthStatusTitle" Text="System Health Status" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DashRecommendation" Text="Healthy" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="21,0,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource BrushBgInner}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="DashHealthBadge" Text="Healthy" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right: Actions Hub (Clean minimal buttons) -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="DashQuickActionsTitle" Text="Quick Actions" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,16"/>

                                <!-- Primary Action (Clean White Button) -->
                                <Button Style="{StaticResource BtnPrimaryWhite}" Click="BtnQuickPurge_Click" Margin="0,0,0,10" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconBroom}" Width="13" Height="13" Fill="{DynamicResource BrushTextDark}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DashQuickPurgeRamText" Text="Flush RAM Cache" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource BtnPill}" Click="BtnToggleHud_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPictureInPicture}" Width="13" Height="13" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DashToggleHudText" Text="Toggle HUD Overlay" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource BtnPill}" Click="TabNav_Click" Tag="2" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTrash}" Width="13" Height="13" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DashCleanJunkText" Text="Clean Temporary Files" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- TAB 1: RAM & TURBO                         -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentRam" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="RamTabHeading" Text="Physical Memory Optimization" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnSwitchPurgeMode" Style="{StaticResource BtnIconCircle}" Click="BtnSwitchPurgeMode_Click" Margin="10,0,0,0" ToolTip="Switch between RAM and CPU Optimization" Width="28" Height="28" VerticalAlignment="Center">
                                <Path x:Name="IconPurgeChevron" Data="{StaticResource IconChevronDown}" Width="9" Height="9" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="RamTabSub" Text="Working set trimming and process priority acceleration" FontSize="13.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Hero Action Card -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <Path x:Name="RamHeroIcon" Data="{StaticResource IconRam}" Width="15" Height="15" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamBannerTitle" Text="Working Set Memory Trimming" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="RamBannerSub" Text="Safely returns unused pages from background processes to physical memory, preventing pagefile inflation." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="BtnFullPurge" Style="{StaticResource BtnPrimaryWhite}" Click="BtnFullPurge_Click" Margin="20,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="BtnFullPurgeIcon" Data="{StaticResource IconBroom}" Width="13" Height="13" Fill="{DynamicResource BrushTextDark}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BtnFullPurgeText" Text="Purge Memory Now" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Split view: Details & Terminal Log -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Metrics Card (Clean rows, no chunky boxes!) -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock x:Name="RamDetailHeader" Text="MEMORY SPECIFICATION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16"/>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="RamTotalLabel" Text="Total RAM:" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="RamDetailTotal" Text="8.00 GB" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="RamUsedLabel" Text="In Use:" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamDetailUsed" Text="-- GB" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,14">
                                    <TextBlock x:Name="RamAvailLabel" Text="Available:" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamDetailAvail" Text="-- GB" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </Grid>

                                <Button x:Name="BtnRamOpenInspector" Style="{StaticResource BtnPill}" Click="BtnOpenTaskManager_Click" HorizontalContentAlignment="Center" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSquaresFour}" Width="13" Height="13" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BtnRamOpenInspectorText" Text="Open Task Manager" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right Live Log -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="RamLogTitle" Grid.Row="0" Text="PURGE ACTIVITY LOG" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12"/>

                                <TextBox Grid.Row="1" x:Name="RamLogTextBox" 
                                         Background="{DynamicResource BrushBgBase}" 
                                         BorderBrush="{DynamicResource BrushBorderCard}" 
                                         BorderThickness="1" 
                                         Foreground="{DynamicResource BrushTextPrimary}" 
                                         FontFamily="{DynamicResource FontMono}" 
                                         FontSize="11.5" 
                                         IsReadOnly="True" 
                                         VerticalScrollBarVisibility="Auto" 
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         Padding="12"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- TAB 2: STORAGE                             -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentStorage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="StorageTabHeading" Text="Storage &amp; System Cleanup" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock x:Name="StorageTabSub" Text="Monitor drive capacity and safely remove temporary cache files" FontSize="13.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                        
                    </StackPanel>

                    <!-- Disk Gauge (Informational display, selection via dropdown) -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconHardDrive}" Width="13" Height="13" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StorageGaugeTitle" Text="Storage Capacity (C:):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnStorageDiskDropdown" Style="{StaticResource BtnIconCircle}" Click="BtnDiskDropdown_Click" Margin="4,0,0,0" ToolTip="Select Drive">
                                        <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="StorageHeaderStatus" Text="Free: -- GB of -- GB" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <ProgressBar x:Name="StorageProgressC" Style="{StaticResource ProgressBarMonochrome}" Height="4" Value="0" Maximum="100"/>
                        </StackPanel>
                    </Border>

                    <!-- Split view: Targets & Console Activity Log -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cleanable Targets -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="CleanTargetsTitle" Grid.Row="0" Text="SAFE CLEANUP TARGETS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,14"/>

                                <ListBox Grid.Row="1" x:Name="CleanTargetsList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Path Grid.Column="0" Data="{StaticResource IconTrash}" Width="13" Height="13" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnScanJunk" Style="{StaticResource BtnPill}" Click="BtnScanJunk_Click" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconArrowClockwise}" Width="12" Height="12" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="BtnScanJunkText" Text="Scan Cache" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCleanSystem" Style="{StaticResource BtnPrimaryWhite}" Click="BtnCleanSystem_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTrash}" Width="12" Height="12" Fill="{DynamicResource BrushTextDark}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="BtnCleanSystemText" Text="Clean System Cache" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live Terminal / Console Output -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock x:Name="StorageLogTitle" Text="ACTIVITY &amp; CLEANUP CONSOLE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnClearStorageLog" Style="{StaticResource BtnHudControl}" HorizontalAlignment="Right" Click="BtnClearStorageLog_Click" ToolTip="Clear Console">
                                        <Path Data="{StaticResource IconClose}" Width="8" Height="8" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <Border Grid.Row="1" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <ScrollViewer x:Name="StorageLogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBox x:Name="StorageLogTextBox"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource BrushTextSecondary}"
                                                 BorderThickness="0"
                                                 FontFamily="{DynamicResource FontMono}"
                                                 FontSize="11"
                                                 IsUndoEnabled="False"/>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock x:Name="StorageLogFooter" Grid.Row="2" Text="Ready" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="2,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- TAB 3: GAMES (SENTINEL & CATALOG)          -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentGames" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="GamesTabHeading" Text="Game Sentinel &amp; Catalog" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock x:Name="GamesTabSub" Text="Active games telemetry, priority acceleration, and installed disk libraries" FontSize="13.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Hero Banner: Game Booster -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGamepad}" Width="15" Height="15" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GamesBannerTitle" Text="Game Priority Booster" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="GamesBannerSub" Text="Elevates process CPU priority to High for active games (Minecraft, CS2, Dota 2, and others) to ensure maximum FPS." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnGamesBoostHero" Style="{StaticResource BtnPrimaryWhite}" Click="BtnBoostGamePriority_Click" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconLightning}" Width="13" Height="13" Fill="{DynamicResource BrushTextDark}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BtnGamesBoostText" Text="Boost Game Priority" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Split View: Left (Active Games & Load) + Right (Installed Games Scanner) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Active Games & Hardware Load -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock x:Name="ActiveGamesSectionTitle" Text="ACTIVE GAMES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnRefreshActiveGames" Style="{StaticResource BtnIconCircle}" Click="BtnRefreshActiveGames_Click" HorizontalAlignment="Right" ToolTip="Refresh active games list">
                                        <Path Data="{StaticResource IconClock}" Width="11" Height="11" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- Active Games List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListActiveGames">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,4"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="CPU: " FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                                <TextBlock Text="{Binding FormattedCpu}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0"/>
                                                                <TextBlock Text="RAM: " FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                                <TextBlock Text="{Binding FormattedRam}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource BrushBgElevated}" CornerRadius="6" Padding="8,4">
                                                            <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="TxtNoActiveGames" Grid.Row="1" Text="No games currently running." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
                            </Grid>
                        </Border>

                        <!-- Right: Installed Games Catalog & Drive Scanner -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="14" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header + Drive Filter & Scan Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="InstalledGamesSectionTitle" Text="GAMES ON THIS DEVICE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}"/>
                                        <TextBlock x:Name="InstalledGamesSubtitle" Text="Scan storage drives for installed games, libraries and launchers" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Launcher Filter Toggle Button (Gear) -->
                                        <Button x:Name="BtnToggleLaunchers" Style="{StaticResource BtnIconCircle}" Click="BtnToggleLaunchers_Click" Width="30" Height="30" Margin="0,0,8,0" ToolTip="Minecraft launchers filter">
                                            <Path x:Name="IconToggleLaunchers" Data="{StaticResource IconGear}" Width="12" Height="12" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Drive Selector Button -->
                                        <Button x:Name="BtnGameDriveFilter" Style="{StaticResource BtnPill}" Click="BtnGameDriveFilter_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtGameDriveFilter" Text="All Drives" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Path Data="{StaticResource IconChevronDown}" Width="8" Height="8" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Scan Button -->
                                        <Button x:Name="BtnScanGames" Style="{StaticResource BtnPrimaryWhite}" Click="BtnScanGames_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFolder}" Width="12" Height="12" Fill="{DynamicResource BrushTextDark}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="BtnScanGamesText" Text="Scan Drives" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Status bar for Scan (count, total size) -->
                                <Border Grid.Row="1" Background="{DynamicResource BrushBgBase}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                    <Grid>
                                        <TextBlock x:Name="InstalledScanStatusText" Text="Click 'Scan Drives' to discover games on your PC." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="InstalledScanCountText" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Installed Games List -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListInstalledGames">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            <TextBlock Text="{Binding InstallPath}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,10,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="14,0"/>
                                                        <Button Grid.Column="2" Style="{StaticResource BtnPill}" Click="BtnOpenGameFolder_Click" Tag="{Binding InstallPath}" ToolTip="Open in File Explorer" VerticalAlignment="Center" Padding="8,4">
                                                            <Path Data="{StaticResource IconFolder}" Width="12" Height="12" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="TxtScanPlaceholder" Grid.Row="2" Text="No scan performed yet. Select a drive and click 'Scan Drives'." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>

                                <TextBlock x:Name="InstalledGamesFooterInfo" Grid.Row="3" Text="Scans Steam, Xbox, Epic, AppData (.minecraft, .tlauncher), and custom drive game folders." FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- TAB 4: SETTINGS                            -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Title and Reset Defaults Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="SettingsHeadingTitle" Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="SettingsHeadingSub" Text="System configuration, customization and hardware specifications" FontSize="13.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Reset Defaults Button -->
                        <Button Grid.Column="1" x:Name="BtnResetSettings" Style="{StaticResource BtnPill}" Click="BtnResetSettings_Click" Padding="14,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconArrowClockwise}" Width="12" Height="12" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtResetSettings" Text="Reset Defaults" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Settings Body Area with Floating Sticky Header Overlay -->
                    <Grid Grid.Row="1">
                        <!-- Accordions (No scrollbar shown, smooth mouse-wheel scrolling!) -->
                        <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Hidden" ScrollChanged="SettingsScrollViewer_ScrollChanged" SizeChanged="SettingsScrollViewer_SizeChanged">
                        <StackPanel>

                            <!-- ACCORDION 1: Customization -->
                            <Expander x:Name="ExpCustom" Style="{StaticResource AccordionExpander}" Header="Customization" Margin="0,0,0,8" Expanded="Expander_Expanded" PreviewMouseLeftButtonDown="Expander_PreviewMouseLeftButtonDown">
                                <StackPanel Margin="0,4,0,0">

                                    <!-- Language -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LangSettingTitle" Text="Interface Language" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LangSettingDesc" Text="Default is English. Switchable instantly." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <UniformGrid Grid.Column="1" Columns="2">
                                            <Button x:Name="BtnLangEn" Style="{StaticResource BtnPrimaryWhite}" Click="BtnLang_Click" Tag="EN" Margin="0,0,4,0" HorizontalContentAlignment="Center">
                                                <TextBlock Text="English" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="BtnLangRu" Style="{StaticResource BtnPill}" Click="BtnLang_Click" Tag="RU" HorizontalContentAlignment="Center">
                                                <TextBlock Text="Русский" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </UniformGrid>
                                    </Grid>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16"/>

                                    <!-- Theme -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThemeSettingTitle" Text="Interface Theme" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="ThemeSettingDesc" Text="Dark or light theme for the entire workspace" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <UniformGrid Grid.Column="1" Columns="2">
                                            <Button x:Name="BtnThemeDark" Style="{StaticResource BtnPrimaryWhite}" Click="BtnTheme_Click" Tag="Dark" Margin="0,0,4,0" HorizontalContentAlignment="Center">
                                                <TextBlock x:Name="ThemeDarkText" Text="Dark" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="BtnThemeLight" Style="{StaticResource BtnPill}" Click="BtnTheme_Click" Tag="Light" HorizontalContentAlignment="Center">
                                                <TextBlock x:Name="ThemeLightText" Text="Light" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </UniformGrid>
                                    </Grid>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16"/>

                                    <!-- Time Format -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TimeFormatSettingTitle" Text="Time Format" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="TimeFormatSettingDesc" Text="12-hour (AM/PM) or 24-hour clock display" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <UniformGrid Grid.Column="1" Columns="2">
                                            <Button x:Name="BtnTime12h" Style="{StaticResource BtnPrimaryWhite}" Click="BtnTimeFormat_Click" Tag="12" Margin="0,0,4,0" HorizontalContentAlignment="Center">
                                                <TextBlock x:Name="BtnTime12hText" Text="12-hour" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="BtnTime24h" Style="{StaticResource BtnPill}" Click="BtnTimeFormat_Click" Tag="24" HorizontalContentAlignment="Center">
                                                <TextBlock x:Name="BtnTime24hText" Text="24-hour" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </UniformGrid>
                                    </Grid>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16"/>

                                    <!-- HUD Opacity -->
                                    <StackPanel Margin="0,0,0,16">
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock x:Name="HudOpacityTitle" Text="HUD Overlay Opacity" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="TxtHudOpacityVal" Text="85%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        </Grid>
                                        <Slider x:Name="SliderHudOpacity" Minimum="20" Maximum="100" Value="85" SmallChange="1" LargeChange="5" ValueChanged="SliderHudOpacity_ValueChanged"/>
                                    </StackPanel>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16"/>

                                    <!-- TAB MANAGER & VAULT -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TabManagerTitle" Text="Вкладки" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="TabManagerDesc" Text="Управление списком вкладок навигации, удаление и сортировка" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnToggleTabEdit" Style="{StaticResource BtnPill}" Click="BtnToggleTabEdit_Click" Padding="14,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path x:Name="IconTabEditPath" Data="{StaticResource IconGear}" Width="11" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtToggleTabEdit" Text="Редактировать" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- TAB STORAGE / VAULT (Хранилище вкладок) -->
                                    <Border Background="{DynamicResource BrushBgInner}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TabVaultTitle" Text="Хранилище вкладок" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock x:Name="TabVaultDesc" Text="Вкладки, не добавленные в навигацию. Нажмите Открыть для добавления" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" x:Name="BtnOpenTabVault" Style="{StaticResource BtnPill}" Click="BtnOpenTabVault_Click" Padding="14,6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtBtnOpenTabVault" Text="Открыть" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                        <Path x:Name="IconVaultChevron" Data="{StaticResource IconChevronDown}" Width="9" Height="9" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Expanded Vault Drawer -->
                                            <StackPanel x:Name="VaultDrawerPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="TxtVaultEmpty" Text="Все доступные вкладки активны в навигации." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="4,4,0,4"/>
                                                <StackPanel x:Name="VaultItemsContainer"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Expander>

                            <!-- ACCORDION 2: Monitoring & Tools -->
                            <Expander x:Name="ExpMonitor" Style="{StaticResource AccordionExpander}" Header="Monitoring &amp; Tools" Margin="0,0,0,8" Expanded="Expander_Expanded" PreviewMouseLeftButtonDown="Expander_PreviewMouseLeftButtonDown">
                                <StackPanel Margin="0,4,0,0">

                                    <!-- === TELEMETRY === -->
                                    <TextBlock x:Name="TelemetrySectionTitle" Text="TELEMETRY &amp; POLLING" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="IntervalTitle" Text="Metrics sampling interval:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="IntervalDesc" Text="Determines update frequency for CPU, RAM and storage metrics" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnIntervalSelector" Style="{StaticResource BtnPill}" Click="BtnIntervalSelector_Click" Padding="12,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtIntervalCurrent" Text="1.5s" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Auto RAM Purge -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="AutoRamTitle" Text="Auto-purge on memory spike (> 85%)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="AutoRamDesc" Text="Background working set trim when RAM is near capacity" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnToggleAutoRam" Style="{StaticResource BtnPrimaryWhite}" Click="BtnToggleAutoRam_Click" Padding="14,6" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtAutoRamStatus" Text="Enabled" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- Auto Game Priority -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="AutoGamePriorityTitle" Text="Automatic Game Priority" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="AutoGamePriorityDesc" Text="Auto-boost javaw, cs2, dota2 upon launch" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnToggleAutoGamePriority" Style="{StaticResource BtnPrimaryWhite}" Click="BtnToggleAutoGamePriority_Click" Padding="14,6" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtAutoGamePriorityStatus" Text="Enabled" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- RAM Manual Purge -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ManualRamTitle" Text="Manual memory optimization:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="SettingsRamStatusText" Text="Last optimization: waiting for trigger" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnSettingsPurgeRam" Style="{StaticResource BtnPill}" Click="BtnSettingsPurgeRam_Click" Padding="14,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconLightning}" Width="12" Height="12" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="BtnSettingsPurgeRamText" Text="Purge RAM" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16"/>

                                    <!-- === STORAGE & THRESHOLDS === -->
                                    <TextBlock x:Name="StorageSectionTitle" Text="STORAGE &amp; THRESHOLDS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DiskThresholdTitle" Text="Drive warning threshold:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="DiskThresholdDesc" Text="Warning status triggers when free space drops below threshold" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,10,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnThresholdSelector" Style="{StaticResource BtnPill}" Click="BtnThresholdSelector_Click" Padding="12,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtThresholdCurrent" Text="7 GB" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16"/>

                                    <!-- === ALERTS === -->
                                    <TextBlock x:Name="AlertSectionTitle" Text="ALERT THRESHOLDS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <TextBlock x:Name="CpuAlertTitle" Text="CPU Alert Threshold (%):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtCpuAlertVal" Text="90%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider x:Name="SliderCpuAlert" Minimum="50" Maximum="99" Value="90" SmallChange="1" LargeChange="5" ValueChanged="SliderCpuAlert_ValueChanged" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,10">
                                        <TextBlock x:Name="RamAlertTitle" Text="RAM Alert Threshold (%):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRamAlertVal" Text="85%" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider x:Name="SliderRamAlert" Minimum="50" Maximum="99" Value="85" SmallChange="1" LargeChange="5" ValueChanged="SliderRamAlert_ValueChanged" Margin="0,0,0,16"/>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16"/>

                                    <!-- === STARTUP === -->
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock x:Name="StartupSectionTitle" Text="STARTUP MANAGER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnPill}" Click="BtnRefreshStartup_Click" Padding="10,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconArrowClockwise}" Width="11" Height="11" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="BtnRefreshStartupText" Text="Refresh" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ListBox x:Name="StartupList" MaxHeight="220" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushBgInner}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource BrushBgButton}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Command}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource BtnPill}" Click="BtnStartupToggle_Click" Tag="{Binding}" Padding="8,4" Margin="8,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding EnabledText}" FontSize="11" FontWeight="SemiBold"/>
                                                        </Button>
                                                        <Button Grid.Column="3" Style="{StaticResource BtnPill}" Click="BtnStartupDelete_Click" Tag="{Binding}" Padding="8,4" VerticalAlignment="Center" ToolTip="Remove from startup">
                                                            <Path Data="{StaticResource IconTrash}" Width="11" Height="11" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,16,0,16"/>

                                    <!-- === NETWORK === -->
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock x:Name="NetworkSectionTitle" Text="NETWORK ADAPTERS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnPill}" Click="BtnPingAll_Click" Padding="10,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconSearch}" Width="11" Height="11" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="BtnPingAllText" Text="Ping (8.8.8.8)" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ListBox x:Name="NetworkList" MaxHeight="180" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushBgInner}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding IpAndMac}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource BrushBgButton}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </StackPanel>
                            </Expander>

                            <!-- ACCORDION 3: System Specs -->
                            <Expander x:Name="ExpSysInfo" Style="{StaticResource AccordionExpander}" Header="Система" Margin="0,0,0,8" Expanded="ExpSysInfo_Expanded" PreviewMouseLeftButtonDown="Expander_PreviewMouseLeftButtonDown">
                                <StackPanel x:Name="SysInfoPanel" Margin="0,4,0,0">
                                    <TextBlock x:Name="SysInfoLoadingText" Text="Поиск характеристик системы..." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,8"/>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Floating Sticky Header (1:1 identical to original expander header) -->
                    <Border x:Name="StickyAccordionBar" VerticalAlignment="Top" Visibility="Collapsed"
                            Background="{DynamicResource BrushBgSurface}"
                            BorderBrush="{DynamicResource BrushBorderCard}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20,16"
                            Cursor="Hand"
                            MouseLeftButtonDown="BtnCollapseSticky_Click"
                            PreviewMouseWheel="StickyAccordionBar_PreviewMouseWheel">
                        <Grid>
                            <TextBlock x:Name="StickyAccordionTitle" Text="Customization" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Path x:Name="StickyChevron" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

        <!-- ============================================================ -->
        <!-- 3. FOOTER STATUS BAR                                         -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="StatusFooterText" Text="" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconClock}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterClockText" Text="--:--:-- (UTC --:--:--)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 4. MODERN MODAL CONFIRMATION DIALOG OVERLAY                  -->
        <!-- ============================================================ -->
        <Grid x:Name="ModernModalOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="9999" Background="#CC0A0D14">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BrushBgSurface}"
                    BorderBrush="{DynamicResource BrushBorderCard}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="440"
                    Padding="26,24"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon Circle Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource BrushBgElevated}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path x:Name="ModalIconPath" Data="{StaticResource IconInfo}" Width="18" Height="18" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ModalDialogTitle" Text="Подтверждение" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="ModalDialogSub" Text="Действие требует подтверждения" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ModalDialogMessage" Text="Вы уверены, что хотите выполнить это действие?" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" x:Name="BtnModalCancel" Style="{StaticResource BtnPill}" Content="Отмена" Padding="18,8" Margin="0,0,10,0" Click="BtnModalCancel_Click"/>
                        <Button Grid.Column="2" x:Name="BtnModalConfirm" Style="{StaticResource BtnPrimaryWhite}" Content="Подтвердить" Padding="20,8" Click="BtnModalConfirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
