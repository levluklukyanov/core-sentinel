<Window x:Class="CoreSentinel.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диспетчер процессов · CoreSentinel" 
        Icon="app.ico"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Width="940" Height="650"
        MinWidth="740" MinHeight="480"
        Background="{DynamicResource BrushBgBase}"
        FontFamily="{DynamicResource FontMain}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <!-- 0. Custom Titlebar -->
            <RowDefinition Height="44"/>
            <!-- 1. Toolbar & Controls -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Process Table -->
            <RowDefinition Height="*"/>
            <!-- 3. Footer Status Bar -->
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 0. CUSTOM TITLEBAR                                           -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Window Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconShield}" Width="14" Height="14" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Диспетчер процессов" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource BrushBorderHover}" Margin="9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DashSummaryText" Text="Загрузка метрик..." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Caption Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnMinimize_Click" Style="{StaticResource WinCaptionButton}">
                        <Path Data="M 0,5 H 10 V 6 H 0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnMaximize_Click" Style="{StaticResource WinCaptionButton}">
                        <Path Data="M 0,0 H 9 V 9 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Fill="Transparent" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="BtnClose_Click" Style="{StaticResource WinCloseButton}">
                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 1. TOOLBAR & CONTROLS                                        -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <!-- Search Box -->
                <ColumnDefinition Width="260"/>
                <!-- Sorting Pills -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <!-- Action Buttons -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Filter Input -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="28,6,10,6" VerticalAlignment="Center"/>
                <Path Data="{StaticResource IconSearch}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Поиск процесса или PID..." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- Sorting Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Сортировка:" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="BtnSortCpu" Style="{StaticResource BtnPill}" Click="BtnSortCpu_Click" Margin="0,0,6,0" Padding="12,5">
                    <TextBlock Text="По CPU" FontSize="11.5" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="BtnSortRam" Style="{StaticResource BtnPrimaryWhite}" Click="BtnSortRam_Click" Padding="12,5">
                    <TextBlock Text="По ОЗУ" FontSize="11.5" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>

            <!-- Actions (Purge RAM, End Process, Refresh) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnOpenTaskmgr" Style="{StaticResource BtnPill}" Click="BtnOpenTaskmgr_Click" Margin="0,0,8,0" Padding="12,6" ToolTip="Открыть системный Диспетчер задач Windows">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCpu}" Width="11" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Диспетчер задач" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnPurgeProcessRam" Style="{StaticResource BtnPill}" Click="BtnPurgeProcessRam_Click" IsEnabled="False" Margin="0,0,8,0" Padding="12,6" ToolTip="Сбросить рабочий набор выбранного процесса">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLightning}" Width="11" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Очистить ОЗУ" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnKillProcess" Style="{StaticResource BtnPill}" Click="BtnKillProcess_Click" IsEnabled="False" Margin="0,0,8,0" Padding="12,6" ToolTip="Принудительно завершить выбранный процесс">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconClose}" Width="10" Height="10" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Снять задачу" FontSize="11.5"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnRefresh" Style="{StaticResource BtnPill}" Click="BtnRefresh_Click" Padding="8,6" ToolTip="Принудительно обновить список прямо сейчас">
                    <Path Data="{StaticResource IconArrowClockwise}" Width="12" Height="12" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================ -->
        <!-- 2. MAIN PROCESS TABLE (SMOOTH VIRTUALIZED DATA)              -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="1" CornerRadius="12" Margin="18,0,18,12" Padding="2" ClipToBounds="True">
            <ListView x:Name="ProcessListView" 
                      SelectionChanged="ProcessListView_SelectionChanged"
                      ItemContainerStyle="{StaticResource ProcessListViewItemStyle}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GridViewHeaderStyle}">
                        <!-- Process Name & PID -->
                        <GridViewColumn Width="210">
                            <GridViewColumn.Header>
                                <TextBlock Text="ПРОЦЕСС"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="2,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Pid, StringFormat='PID: {0}'}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- CPU % + Mini Progress -->
                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <TextBlock Text="CPU %"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" Margin="2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding FormattedCpu}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                                        <ProgressBar Grid.Row="1" Value="{Binding CpuPercent}" Maximum="100" Style="{StaticResource ProgressBarMonochrome}" Height="2.5" Margin="0,3,0,0" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Memory (RAM) -->
                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <TextBlock Text="ПАМЯТЬ"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedRam}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="2,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Threads -->
                        <GridViewColumn Width="70">
                            <GridViewColumn.Header>
                                <TextBlock Text="ПОТОКИ"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ThreadCount}" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Priority -->
                        <GridViewColumn Width="95">
                            <GridViewColumn.Header>
                                <TextBlock Text="ПРИОРИТЕТ"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushBgInner}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Priority}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Window Title / Description -->
                        <GridViewColumn Width="310">
                            <GridViewColumn.Header>
                                <TextBlock Text="ОКНО / ОПИСАНИЕ"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WindowTitle}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- ============================================================ -->
        <!-- 3. FOOTER STATUS BAR                                         -->
        <!-- ============================================================ -->
        <Border Grid.Row="3" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Feedback Text -->
                <TextBlock Grid.Column="0" x:Name="StatusFooterText" Text="Диспетчер процессов активен. Выберите строку для управления." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>

                <!-- Live Update Tag -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="UpdateIndicatorDot" Width="6" Height="6" Fill="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterProcessCountText" Text="Всего процессов: --" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
