<Window x:Class="CoreSpectre.TelemetryHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreSpectre HUD" 
        Height="38" Width="410"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="20" Top="20"
        FontFamily="{DynamicResource FontMain}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Border x:Name="HudRootBorder"
            Background="{DynamicResource BrushBgBase}"
            BorderBrush="{DynamicResource BrushBorderCard}" 
            BorderThickness="1" 
            CornerRadius="8" 
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            SnapsToDevicePixels="True">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Status Indicator -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="HudStatusDot" Width="6" Height="6" Fill="{DynamicResource BrushTextMuted}" Margin="0,0,7,0"/>
                <TextBlock Text="SPECTRE" 
                           FontFamily="{DynamicResource FontMain}" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource BrushTextMuted}" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Live Metrics -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="CPU " FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                <TextBlock x:Name="HudCpuText" Text="0%" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{DynamicResource FontMain}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                <TextBlock Text="RAM " FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                <TextBlock x:Name="HudRamText" Text="0%" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{DynamicResource FontMain}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                <StackPanel x:Name="HudGpuPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0">
                    <TextBlock Text="GPU " FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HudGpuText" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Clickable Disk Metric to cycle drives -->
                <StackPanel x:Name="HudDiskPanel" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="HudDiskPanel_MouseLeftButtonDown" ToolTip="Click to switch monitored drive">
                    <TextBlock x:Name="HudDiskLabel" Text="C: " FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HudDiskText" Text="0G" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Controls (Click-through / Close) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnLockHud" 
                        Style="{DynamicResource BtnHudControl}"
                        ToolTip="Click-Through Mode (Ctrl+Shift+L)"
                        Click="BtnLockHud_Click" 
                        Margin="0,0,4,0">
                    <Path x:Name="HudLockIcon" Data="{DynamicResource IconLockOpen}" Width="10" Height="10" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnCloseHud"
                        Style="{DynamicResource BtnHudControl}"
                        ToolTip="Hide HUD (Ctrl+Shift+H)"
                        Click="BtnClose_Click">
                    <Path Data="{DynamicResource IconClose}" Width="8" Height="8" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
