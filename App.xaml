<Application x:Class="CoreSpectre.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Динамические токены типографики (инициализируются и меняются через FontService) -->
            <FontFamily x:Key="FontMain">Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="FontMono">Consolas, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
